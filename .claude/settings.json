{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh stack merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh release *)",
      "Bash(gh auth token)",
      "Bash(git tag *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(source *.env)",
      "Bash(source *.env.local)",
      "Bash(. *.env)",
      "Bash(. *.env.local)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ssh-add *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.config/skillforge/**)",
      "WebFetch(domain:my.sevdesk.de)",
      "WebFetch(domain:graph.microsoft.com)",
      "WebFetch(domain:login.microsoftonline.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
