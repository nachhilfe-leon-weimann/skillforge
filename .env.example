# SkillForge - example configuration
#
# Copy and fill in:  cp .env.example .env
#
# Settings are loaded from the environment / .env via pydantic-settings.
#
# Legend:  [REQUIRED] must be set, [optional] default applies when omitted.


# --- Auth (prefix AUTH__) -----------------------------------------------------
# OAuth2 client credentials + JWT, user accounts and their logins.

# [REQUIRED] Symmetric key used to sign the JWTs. Any random secret string,
#            e.g.:  openssl rand -hex 32
AUTH__SECRET_KEY=change-me-to-a-random-secret

# [optional] JWT signing algorithm.  Default: HS256
#            Possible values (symmetric): HS256 | HS384 | HS512
AUTH__ALGORITHM=HS256

# [optional] JWT "iss" claim.  Default: skillforge
AUTH__ISSUER=skillforge

# [optional] JWT "aud" claim.  Default: skillforge-api
AUTH__AUDIENCE=skillforge-api

# [optional] Access token lifetime in minutes.  Default: 15
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15

# [optional] Lifetime of an invitation token in hours.  Default: 168 (7 days)
AUTH__INVITATION_EXPIRE_HOURS=168

# [optional] Lifetime of a password-reset token in hours.  Default: 24
AUTH__PASSWORD_RESET_EXPIRE_HOURS=24

# [optional] Lifetime of a Discord link code in hours.  Default: 24
AUTH__DISCORD_LINK_CODE_EXPIRE_HOURS=24

# [optional] Absolute lifetime of a login session (its refresh token) in days.  Default: 30
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=30

# [optional] Failed password logins in a row after which an account is locked.  Default: 5
AUTH__LOGIN_LOCKOUT_THRESHOLD=5

# [optional] Longest lock in minutes; the lock doubles from 1 minute per further failure.  Default: 15
AUTH__LOGIN_LOCKOUT_MAX_MINUTES=15


# --- Database (prefix DB__) -----------------------------------------------------
# Postgres via the async driver asyncpg.

# [REQUIRED] Connection URL used by the app (the pooled Neon connection in prod).
#            Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
DB__URL=postgresql+asyncpg://skillforge:skillforge@localhost:5432/skillforge

# [optional] Direct, unpooled URL used only for migrations (Alembic).  Default:
#            falls back to DB__URL. Required in prod because a PgBouncer pooler
#            (Neon "-pooler") breaks advisory locks + CONCURRENTLY. See ADR 0002.
#DB__MIGRATION_URL=postgresql+asyncpg://skillforge:skillforge@db.direct-host:5432/skillforge


# --- sevDesk (prefix SEVDESK__) -------------------------------------------------
# All optional: the app starts without them, and a sevDesk call without a token or
# an expected account id is refused. An empty value means unset, except for the
# token. The ids differ between the trial and the live account;
# `just sevdesk-doctor trial|live` checks them. The trial's values live in the env
# file the trial recipes load, outside this repository.

# [optional] dry_run sends reads only and returns writes as planned requests.  Default: dry_run
#            Possible values: dry_run | live
SEVDESK__MODE=

# [optional] Which account the token belongs to; trial requires TRIAL in the
#            company name.  Default: trial
#            Possible values: trial | live
SEVDESK__ACCOUNT=

# [optional] API token, sent as the raw Authorization header. An empty token is
#            refused, so the line stays commented out until there is one.
#SEVDESK__TOKEN=

# [optional] The SevClient id the token must belong to (identity check).
#            `just sevdesk-doctor <account> --discover` prints it.
SEVDESK__EXPECTED_ACCOUNT_ID=

# [optional] The SevUser named as contact person on every invoice.
SEVDESK__CONTACT_PERSON_ID=

# [optional] The Unity of an invoice position counted in hours.
SEVDESK__HOUR_UNIT_ID=

# [optional] The ContactCustomFieldSetting holding a contact's payment method.
SEVDESK__PAYMENT_METHOD_FIELD_SETTING_ID=


# --- Microsoft Graph (prefix GRAPH__) -------------------------------------------
# The read of the lesson calendar. All optional: the app starts without them, and
# a calendar read without the credential, the mailbox or the calendar name is
# refused. An empty value means unset, except for the two secrets.

# [optional] As for sevDesk; the calendar client has no write, so both values
#            behave alike today.  Default: dry_run
#            Possible values: dry_run | live
GRAPH__MODE=

# [optional] The Entra tenant id and the application (client) id of the app
#            `skillforge`, each a UUID.
GRAPH__TENANT_ID=
GRAPH__CLIENT_ID=

# [optional] This location's certificate and its unencrypted RSA key, each as
#            its PEM text base64-encoded into one line (base64 < file.pem | tr -d '\n').
#            Secrets: an empty value is refused, so the lines stay commented out.
#GRAPH__CERTIFICATE_PEM=
#GRAPH__PRIVATE_KEY_PEM=

# [optional] The mailbox address that holds the lesson calendar, and the
#            calendar's name in it.
GRAPH__MAILBOX=
GRAPH__CALENDAR_NAME=


# --- Logging (prefix LOGGING__) -----------------------------------------------------
# All optional. Defaults are suited for local development.

# [optional] Application name shown in logs.  Default: skillforge
LOGGING__APP_NAME=skillforge

# [optional] Log level.  Default: INFO
#            Possible values: NOTSET | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGING__LEVEL=INFO

# [optional] Output format.  Default: console
#            Possible values: console (human-readable) | json (structured, for prod)
LOGGING__FORMAT=console

# [optional] Show local variables in console tracebacks.  Default: false
#            Enable only for local debugging (may leak secrets).
LOGGING__EXCEPTION_SHOW_LOCALS=false

# [optional] Enable rotating JSONL file logging.  Default: false
LOGGING__FILE_ENABLED=false

# [optional] Log file path.  Default: logs/{app_name}.jsonl
#LOGGING__FILE_PATH=logs/skillforge.jsonl

# [optional] Max bytes per log file before rotation.  Default: 10485760 (10 MB)
LOGGING__FILE_MAX_BYTES=10485760

# [optional] Number of rotated files to keep.  Default: 5
LOGGING__FILE_BACKUP_COUNT=5


# --- Billing (prefix BILLING__) -------------------------------------------------
# All optional.

# [optional] Rate in cents per hour for a lesson without its own rate whose student
#            has none either. Must be >= 0 and divisible by 4 (a whole cent per
#            quarter hour).  Default: 3000 (30 EUR)
BILLING__DEFAULT_RATE_CENTS_PER_HOUR=3000
